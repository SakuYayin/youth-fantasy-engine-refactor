{
  "name": "@yfe/desktop",
  "version": "4.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Electron 桌面宿主：main / preload / DB worker / renderer",
  "main": "src/main/main.mjs",
  "exports": {
    ".": {
      "types": "./src/shared/ipc/protocol.ts",
      "default": "./src/shared/ipc/protocol.ts"
    },
    "./ipc": {
      "types": "./src/shared/ipc/protocol.ts",
      "default": "./src/shared/ipc/protocol.ts"
    },
    "./service-host": {
      "types": "./src/main/service-host.mjs",
      "default": "./src/main/service-host.mjs"
    }
  },
  "dependencies": {
    "@yfe/application": "*",
    "@yfe/client-sdk": "*",
    "@yfe/contracts": "*",
    "@yfe/domain": "*",
    "@yfe/persistence-sqlite": "*",
    "@yfe/ui": "*",
    "codemirror": "^6.0.2",
    "vue": "^3.5.44"
  },
  "scripts": {
    "dev": "node bin/dev-desktop.mjs",
    "dev:no-sandbox": "node bin/dev-desktop.mjs --no-sandbox",
    "start": "node bin/dev-desktop.mjs",
    "gui-check": "node bin/dev-desktop.mjs --gui-check",
    "gui-check:no-sandbox": "node bin/dev-desktop.mjs --gui-check --no-sandbox",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "self-check": "node src/main/main.mjs --self-check",
    "dev:renderer": "vite --config vite.config.ts",
    "build:renderer": "vite build --config vite.config.ts"
  }
}
