{
  "name": "youth-fantasy-engine",
  "private": true,
  "version": "4.0.0-dev.0",
  "description": "青春幻想引擎 · 小说创作管理应用（重构版）",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify:new": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run test && npm run build:renderer -w @yfe/desktop",
    "dev:server": "npm run dev -w @yfe/server",
    "dev:desktop": "npm run dev -w @yfe/desktop",
    "gui-check:desktop": "npm run gui-check -w @yfe/desktop --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "electron": "^44.7.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.13"
  }
}
