{
  "name": "@yfe/domain",
  "version": "4.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "领域内核：正文归一化、字数统计、排序键、合并规则。纯逻辑，不依赖 IO",
  "exports": {
    ".": {
      "types": "./src/index.ts",
