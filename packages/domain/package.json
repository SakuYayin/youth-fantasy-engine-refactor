    },
    "./merge": {
      "types": "./src/merge/index.ts",
      "default": "./src/merge/index.ts"
    }
  },
  "dependencies": {
    "@yfe/contracts": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  }
