{
  "name": "@yfe/application",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "应用用例层：用例编排与持久化端口定义，不依赖具体 UI、驱动或全局当前作品",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ports": {
      "types": "./src/ports.ts",
      "default": "./src/ports.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./validate": {
      "types": "./src/validate.ts",
      "default": "./src/validate.ts"
    },
    "./idempotency": {
      "types": "./src/idempotency.ts",
      "default": "./src/idempotency.ts"
    },
    "./useCases": {
      "types": "./src/useCases/index.ts",
      "default": "./src/useCases/index.ts"
    },
    "./useCases/*": {
      "types": "./src/useCases/*.ts",
      "default": "./src/useCases/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@yfe/contracts": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  }
}
