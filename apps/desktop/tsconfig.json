{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "allowJs": true,
    "checkJs": false,
    // 渲染层需要 DOM 类型；tsconfig.base.json 只给 ES2023（那是给纯逻辑包用的）。
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mjs",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
