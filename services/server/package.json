{
  "name": "@yfe/server",
  "version": "4.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "后端服务：Fastify 5 + SQLite，模块化单体（身份/权限/同步/任务/附件）",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./routes": {
      "types": "./src/routes/index.ts",
      "default": "./src/routes/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    "./permission": {
      "types": "./src/permission/index.ts",
      "default": "./src/permission/index.ts"
    },
    "./sync": {
      "types": "./src/sync/index.ts",
      "default": "./src/sync/index.ts"
    }
  },
  "dependencies": {
    "@yfe/contracts": "*",
    "@yfe/domain": "*",
    "@yfe/application": "*",
    "@yfe/persistence-sqlite": "*",
    "fastify": "^5.12.7",
    "@fastify/cookie": "^11.1.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  }
}
